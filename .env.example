# Copy this file to .env and fill in your local/Clever Cloud values.
# Never commit the real .env file.

# ── Clever Cloud / MySQL ─────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_HOST:3306/YOUR_DATABASE?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional: if using Clever Cloud linked-app variables instead of the URL above
# MYSQL_ADDON_HOST=
# MYSQL_ADDON_PORT=3306
# MYSQL_ADDON_DB=
# MYSQL_ADDON_USER=
# MYSQL_ADDON_PASSWORD=

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# ── Mail / OTP ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# ── CORS for local frontend servers ─────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
